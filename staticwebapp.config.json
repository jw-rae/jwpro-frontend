{
  "routes": [
    {
      "route": "/apps/planisphere",
      "rewrite": "/apps/planisphere/index.html"
    },
    {
      "route": "/apps/azure-guide",
      "rewrite": "/apps/azure-guide/index.html"
    },
    {
      "route": "/apps/azure-guide/*",
      "rewrite": "/apps/azure-guide/index.html"
    },
    {
      "route": "/index.html",
      "redirect": "/"
    },
    {
      "route": "/",
      "rewrite": "/api/server"
    }
  ],
  "platform": {
    "apiRuntime": "node:18"
  },
  "navigationFallback": {
    "rewrite": "/api/server"
  }
}